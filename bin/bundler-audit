#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/env.sh"
require_command bundle

args=("$@")

if [ "$#" -eq 0 ]; then
  args=(--config config/bundler-audit.yml)
else
  for arg in "$@"; do
    if [ "$arg" = "check" ]; then
      args+=(--config config/bundler-audit.yml)
      break
    fi
  done
fi

exec bundle exec bundler-audit "${args[@]}"
